{
  "name": "ganttlane-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "bench": "node scripts/bench.mjs",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm lint:deps && pnpm typecheck && pnpm test:coverage && pnpm test:tz && pnpm test:perf && pnpm build && pnpm check:pack && pnpm size",
    "check:pack": "node scripts/check-pack.mjs",
    "dev": "pnpm --filter playground dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "lint:deps": "depcruise packages/*/src internal/*/src apps/playground/src --config .dependency-cruiser.ts --output-type err-long",
    "release": "pnpm build && changeset publish",
    "size": "size-limit",
    "size:each": "node scripts/size-each.mjs",
    "site:build": "pnpm --filter site build",
    "site:dev": "pnpm --filter site dev",
    "size:report": "node scripts/size-report.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:perf": "GANTTLANE_PERF=1 vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:e2e:site": "GANTTLANE_E2E_SITE=1 playwright test --project=site",
    "test:tz": "for tz in UTC America/New_York America/Santiago Europe/Kyiv Asia/Kolkata Pacific/Chatham; do echo \"core tests in TZ=$tz\" && TZ=$tz vitest run --project core --reporter=dot || exit 1; done",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e && pnpm -r --parallel typecheck",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "tsdown": "^0.23.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0",
    "vite": "catalog:",
    "vitest": "^5.0.5"
  }
}
