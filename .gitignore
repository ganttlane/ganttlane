# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo
.vite/
# Astro (apps/site): generated types and the content cache
.astro/
# Pages the site generates each time Astro starts: the API reference (TypeDoc, `typedoc/options.ts`)
# and the migration guide (from the root `MIGRATION.md`). `api/index.mdx` is hand-written.
apps/site/src/content/docs/api/*
!apps/site/src/content/docs/api/index.mdx
apps/site/src/content/docs/guides/migration.md

# tests & tooling
coverage/
test-results/
playwright-report/
blob-report/
.size-limit-cache/

# env & logs
.env
.env.*
!.env.example
*.log
npm-debug.log*
pnpm-debug.log*

# editors & OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# pack-hooks copies of root legal files (prepack/postpack)
packages/*/LICENSE
packages/*/NOTICE

# temporary git worktrees of agents
.claude/worktrees/
# local launch configurations of the desktop app
.claude/launch.json

# local only: internal design docs and agent instructions
/docs/
CLAUDE.md
