---
/**
 * The page the server answers with for an address that is nothing (GitHub Pages serves `404.html`
 * from the root of the site). It is a page of its own, not an entry of the docs collection, so it
 * does not collide with Starlight's `[...slug]` route (`disable404Route` in `astro.config.ts`), and
 * its links are absolute: the same HTML is shown at any address, so a relative link (`../examples/`)
 * would lead somewhere else each time.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const base = import.meta.env.BASE_URL;
---

<StarlightPage
  frontmatter={{
    title: 'Page not found',
    description: 'There is nothing at this address.',
    template: 'splash',
    editUrl: false,
    pagefind: false,
  }}
>
  <p>
    There is nothing at this address. It may have moved, or the link may be mistyped. Try the search
    above, or start from one of these:
  </p>
  <ul>
    <li><a href={base}>The start page</a></li>
    <li><a href={`${base}getting-started/introduction/`}>Getting started</a></li>
    <li><a href={`${base}guides/concepts/`}>Guides</a></li>
    <li><a href={`${base}examples/`}>Live examples</a></li>
    <li><a href={`${base}api/`}>API reference</a></li>
  </ul>
</StarlightPage>
