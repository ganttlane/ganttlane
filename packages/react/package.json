{
  "name": "@ganttlane/react",
  "version": "0.0.0",
  "description": "React components and hooks for interactive gantt charts built on @ganttlane/core.",
  "license": "MIT",
  "keywords": [
    "gantt",
    "gantt-chart",
    "timeline",
    "scheduling",
    "react",
    "react-component"
  ],
  "homepage": "https://github.com/ganttlane/ganttlane/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/ganttlane/ganttlane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganttlane/ganttlane.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@ganttlane/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "@ganttlane/source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.react-18.json",
    "prepack": "node ../../scripts/pack-hooks.mjs prepack",
    "postpack": "node ../../scripts/pack-hooks.mjs postpack"
  },
  "dependencies": {
    "@ganttlane/dom": "workspace:*",
    "@ganttlane/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "./styles.css": {
        "types": "./dist/styles.css.d.ts",
        "default": "./dist/styles.css"
      },
      "./package.json": "./package.json"
    }
  }
}
