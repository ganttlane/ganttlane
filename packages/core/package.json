{
  "name": "@ganttlane/core",
  "version": "0.5.0",
  "description": "Headless gantt-chart core: dates, work calendar, time scale, scheduling, layout and state. No DOM.",
  "license": "MIT",
  "keywords": [
    "gantt",
    "gantt-chart",
    "timeline",
    "scheduling",
    "work-calendar",
    "headless"
  ],
  "homepage": "https://github.com/ganttlane/ganttlane/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ganttlane/ganttlane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganttlane/ganttlane.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@ganttlane/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "development": "./dist/index.development.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "@ganttlane/source": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./migrate": {
      "@ganttlane/source": "./src/migrate.ts",
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/pack-hooks.mjs prepack",
    "postpack": "node ../../scripts/pack-hooks.mjs postpack"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@ganttlane/fixtures": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "development": "./dist/index.development.js",
        "default": "./dist/index.js"
      },
      "./schema": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "./migrate": {
        "types": "./dist/migrate.d.ts",
        "default": "./dist/migrate.js"
      },
      "./package.json": "./package.json"
    }
  }
}
